{
    "layer": "bottom", // Locked underneath normal windows
    "position": "left",
    "width": 34,
    //"margin-top": ,
    //"margin-right": ,
    "modules-center": [
    	"custom/profile",
    	"hyprland/workspace",
    	"custom/session",
    ],


    "hyprland/workspaces": {
             "disable-scroll": true,
             "all-outputs": true,
             "format": "{icon}",
             "format-icons": {
                 "default": "",
                 "active": "",
                 "urgent": ""
             }
         },
