#!/usr/bin/env python3

import json
from datetime import datetime, timedelta
import os
import random
import re
import selectors
import signal
import socket
import subprocess
import sys
import time
from pathlib import Path


# ============================================================
# PATHS
# ============================================================

BASE_DIR = (
    Path.home()
    / ".config"
    / "hypr-mac"
)

WALLPAPER_DIR = (
    BASE_DIR
    / "wpp"
)

STATE_DIR = (
    BASE_DIR
    / "wallpaper-state"
)

SOCKET_PATH = (
    STATE_DIR
    / "controller.sock"
)

STATE_FILE = (
    STATE_DIR
    / "state.json"
)

CURRENT_LINK = (
    STATE_DIR
    / "current"
)


# ============================================================
# CONFIGURATION
# ============================================================

# awww transition settings.
TRANSITION_TYPE = "fade"
TRANSITION_DURATION = 1.0
TRANSITION_FPS = 60


# Supported wallpaper formats.
IMAGE_EXTENSIONS = {
    ".png",
    ".jpg",
    ".jpeg",
    ".webp",
    ".gif",
    ".bmp",
}


# Time slots used by family-time modes.
TIME_SLOTS = {
    "dawn": 5,
    "morning": 9,
    "day": 12,
    "afternoon": 15,
    "dusk": 17,
    "evening": 19,
    "night": 21,
}


# TIME_SLOTS is the single source of truth for family-time.
# Each slot begins at the listed local hour and remains active
# until the next slot begins.  The final slot (night) continues
# through midnight until dawn.
TIME_POINTS = tuple(
    sorted(
        TIME_SLOTS.items(),
        key=lambda item: item[1],
    )
)


# Recognized time-like suffixes.
TIME_NAMES = {
    "dawn",
    "morning",
    "day",
    "afternoon",
    "dusk",
    "evening",
    "night",
    "light",
    "dark",
}


# ============================================================
# RUNTIME
# ============================================================

running = True
restart_requested = False

selector = selectors.DefaultSelector()

server = None

wallpapers = []
wallpaper_dir_mtime_ns = None
family_cache = {}
schedule_cache = {}

state = {
    "current": None,
    "previous": None,
    "mode": "manual",
    "interval": None,
    "family": None,
    "variant": None,
    "next_change": None,
    "last_reason": None,
    "last_changed": None,
}


# ============================================================
# BASIC UTILITIES
# ============================================================

def log(message):

    print(
        f"[wallpaper] {message}",
        flush=True,
    )


def is_image(path):

    return (
        path.is_file()
        and path.suffix.lower()
        in IMAGE_EXTENSIONS
    )


def _wallpaper_dir_signature():

    try:
        return WALLPAPER_DIR.stat().st_mtime_ns
    except OSError:
        return None


def scan_wallpapers(force=False):

    global wallpapers
    global wallpaper_dir_mtime_ns
    global family_cache
    global schedule_cache

    signature = _wallpaper_dir_signature()

    if (
        not force
        and wallpaper_dir_mtime_ns == signature
    ):
        return wallpapers

    if not WALLPAPER_DIR.exists():

        wallpapers = []
        wallpaper_dir_mtime_ns = signature
        family_cache = {}
        schedule_cache = {}
        return wallpapers

    try:

        wallpapers = sorted(
            [
                path.resolve()
                for path in WALLPAPER_DIR.iterdir()
                if is_image(path)
            ],
            key=lambda p: p.name.lower(),
        )

        wallpaper_dir_mtime_ns = signature
        family_cache = {}
        schedule_cache = {}

    except OSError as e:

        log(
            f"could not scan wallpaper directory: {e}"
        )

        wallpapers = []
        wallpaper_dir_mtime_ns = signature
        family_cache = {}
        schedule_cache = {}

    return wallpapers


def path_exists_in_wallpapers(path):

    if path is None:

        return False

    try:

        resolved = (
            Path(path)
            .expanduser()
            .resolve()
        )

    except OSError:

        return False

    return resolved in wallpapers


# ============================================================
# STATE
# ============================================================

def load_state():

    global state

    if not STATE_FILE.exists():

        return

    try:

        with STATE_FILE.open(
            "r",
            encoding="utf-8",
        ) as f:

            loaded = json.load(f)

        if isinstance(
            loaded,
            dict,
        ):

            state.update(
                loaded
            )

    except (
        OSError,
        json.JSONDecodeError,
    ) as e:

        log(
            f"could not read state: {e}"
        )


def save_state():

    STATE_DIR.mkdir(
        parents=True,
        exist_ok=True,
    )

    temporary = (
        STATE_FILE.with_suffix(
            ".tmp"
        )
    )

    try:

        with temporary.open(
            "w",
            encoding="utf-8",
        ) as f:

            json.dump(
                state,
                f,
                indent=2,
            )

            f.write("\n")

        temporary.replace(
            STATE_FILE
        )

    except OSError as e:

        log(
            f"could not save state: {e}"
        )

        try:

            temporary.unlink(
                missing_ok=True
            )

        except OSError:

            pass


# ============================================================
# CURRENT SYMLINK
# ============================================================

def update_current_link(path):

    if path is None:

        return

    try:

        path = (
            Path(path)
            .expanduser()
            .resolve()
        )

    except OSError:

        return

    if not path.exists():

        return

    try:

        if (
            CURRENT_LINK.is_symlink()
            or CURRENT_LINK.exists()
        ):

            CURRENT_LINK.unlink()

        CURRENT_LINK.symlink_to(
            path
        )

    except OSError as e:

        log(
            f"could not update current symlink: {e}"
        )


def remove_current_link():

    try:

        if (
            CURRENT_LINK.is_symlink()
            or CURRENT_LINK.exists()
        ):

            CURRENT_LINK.unlink()

    except OSError:

        pass


# ============================================================
# AWWW
# ============================================================

def run_awww(arguments):

    command = [
        "awww",
        *arguments,
    ]

    try:

        return subprocess.run(
            command,
            capture_output=True,
            text=True,
            check=False,
        )

    except OSError as e:

        return subprocess.CompletedProcess(
            command,
            127,
            "",
            str(e),
        )


def set_awww_wallpaper(path):

    path = (
        Path(path)
        .expanduser()
        .resolve()
    )

    command = [
        "img",
        str(path),
        "--transition-type",
        TRANSITION_TYPE,
        "--transition-fps",
        str(TRANSITION_FPS),
        "--transition-duration",
        str(TRANSITION_DURATION),
    ]

    result = run_awww(
        command
    )

    if result.returncode != 0:

        error = (
            result.stderr.strip()
            or result.stdout.strip()
            or "unknown awww error"
        )

        log(
            f"awww failed: {error}"
        )

        return False

    return True


def query_awww():

    result = run_awww(
        [
            "query",
            "-j",
        ]
    )

    if result.returncode != 0:

        return {
            "error": (
                result.stderr.strip()
                or result.stdout.strip()
                or "awww query failed"
            )
        }

    output = (
        result.stdout.strip()
    )

    if not output:

        return {
            "error": "awww returned no data"
        }

    try:

        return json.loads(
            output
        )

    except json.JSONDecodeError as e:

        return {
            "error": (
                f"could not parse awww JSON: {e}"
            ),
            "raw": output,
        }


def extract_awww_paths(data):

    paths = []

    def walk(value):

        if isinstance(
            value,
            dict,
        ):

            for key, child in value.items():

                lowered = str(
                    key
                ).lower()

                if lowered in {
                    "path",
                    "file",
                    "image",
                    "wallpaper",
                }:

                    if isinstance(
                        child,
                        str,
                    ):

                        candidate = (
                            Path(child)
                            .expanduser()
                        )

                        if candidate.exists():

                            try:

                                paths.append(
                                    str(
                                        candidate.resolve()
                                    )
                                )

                            except OSError:

                                pass

                walk(child)

        elif isinstance(
            value,
            list,
        ):

            for child in value:

                walk(child)

    walk(data)

    # Remove duplicates while preserving order.
    result = []

    seen = set()

    for path in paths:

        if path not in seen:

            seen.add(path)

            result.append(path)

    return result


# ============================================================
# WALLPAPER SELECTION
# ============================================================

def wallpaper_index(path):

    if not path:

        return -1

    try:

        return wallpapers.index(
            Path(path).resolve()
        )

    except (
        ValueError,
        OSError,
    ):

        return -1


def choose_initial_wallpaper():

    scan_wallpapers()

    current = state.get(
        "current"
    )

    if (
        current
        and path_exists_in_wallpapers(
            current
        )
    ):

        return Path(
            current
        ).resolve()

    if wallpapers:

        return wallpapers[0]

    return None


def select_next():

    scan_wallpapers()

    if not wallpapers:

        return None

    current = state.get(
        "current"
    )

    index = wallpaper_index(
        current
    )

    if index < 0:

        return wallpapers[0]

    return wallpapers[
        (index + 1)
        % len(wallpapers)
    ]


def select_previous():

    scan_wallpapers()

    if not wallpapers:

        return None

    current = state.get(
        "current"
    )

    index = wallpaper_index(
        current
    )

    if index < 0:

        return wallpapers[-1]

    return wallpapers[
        (index - 1)
        % len(wallpapers)
    ]


# ============================================================
# FAMILY PARSING
# ============================================================

def split_family(path):

    """
    Turn:

        first-day.png
        first-night.png

    into:

        family = first
        variant = day/night


    And:

        third-blue.jpeg
        third-cyan.jpeg
        third-golden.jpeg
        third-purple.jpeg

    into:

        family = third
        variant = blue/cyan/golden/purple
    """

    stem = path.stem

    match = re.match(
        r"^(.*?)[_-](.+)$",
        stem,
    )

    if not match:

        return (
            stem,
            None,
        )

    family = match.group(1)

    variant = match.group(2).lower()

    return (
        family,
        variant,
    )


def build_families():

    global family_cache

    scan_wallpapers()

    if family_cache:
        return family_cache

    families = {}

    for path in wallpapers:

        family, variant = split_family(path)

        families.setdefault(
            family,
            [],
        ).append(
            (
                path,
                variant,
            )
        )

    family_cache = families

    return family_cache


# ============================================================
# TIME SELECTION
# ============================================================

def current_time_name():

    hour = time.localtime().tm_hour

    selected = "night"

    for name, point in TIME_POINTS:

        if hour >= point:

            selected = name

        else:

            break

    return selected


def time_variant_score(
    variant,
    desired,
):

    if variant is None:

        return 1000

    variant = variant.lower()

    if variant == desired:

        return 0

    aliases = {

        "dawn": {
            "morning": 1,
            "light": 2,
            "day": 3,
        },

        "morning": {
            "dawn": 1,
            "day": 2,
            "light": 3,
        },

        "day": {
            "afternoon": 1,
            "morning": 2,
            "light": 2,
            "dawn": 3,
        },

        "afternoon": {
            "day": 1,
            "evening": 2,
            "light": 3,
        },

        "dusk": {
            "evening": 1,
            "afternoon": 2,
            "night": 3,
            "dark": 3,
        },

        "evening": {
            "dusk": 1,
            "night": 2,
            "dark": 2,
            "afternoon": 3,
        },

        "night": {
            "dark": 1,
            "evening": 2,
            "dusk": 3,
        },

    }

    return aliases.get(
        desired,
        {},
    ).get(
        variant,
        1000,
    )


def choose_time_variant_for_slot(
    family,
    desired,
):

    families = build_families()

    members = families.get(
        family,
        [],
    )

    if not members:

        return None

    best = None
    best_score = 1000
    best_name = None

    for path, variant in members:

        score = time_variant_score(
            variant,
            desired,
        )

        name = path.name.lower()

        if (
            score < best_score
            or (
                score == best_score
                and (
                    best_name is None
                    or name < best_name
                )
            )
        ):
            best = path
            best_score = score
            best_name = name

    return best


def choose_time_variant(
    family,
):

    return choose_time_variant_for_slot(
        family,
        current_time_name(),
    )


def family_time_schedule(
    family,
):

    global schedule_cache

    scan_wallpapers()

    cached = schedule_cache.get(family)

    if cached is not None:
        return cached

    schedule = []

    for name, hour in TIME_POINTS:

        path = choose_time_variant_for_slot(
            family,
            name,
        )

        if path is not None:

            schedule.append(
                (
                    name,
                    hour,
                    path,
                )
            )

    schedule_cache[family] = tuple(schedule)

    return schedule_cache[family]


def next_family_change(
    family,
    current_path=None,
    now=None,
):

    if now is None:
        now = time.time()

    schedule = family_time_schedule(
        family
    )

    if not schedule:
        return None, None, None

    current_resolved = None

    if current_path:
        try:
            current_resolved = str(
                Path(current_path).resolve()
            )
        except OSError:
            current_resolved = str(current_path)

    local_now = datetime.fromtimestamp(now)
    today = local_now.date()

    # The schedule is sorted by hour. Check today's remaining
    # boundaries first, then tomorrow's boundaries. This is enough
    # because the schedule repeats daily.
    for day in (today, today + timedelta(days=1)):

        for name, hour, path in schedule:

            candidate = datetime.combine(
                day,
                datetime.min.time(),
            ).replace(
                hour=hour,
            )

            candidate_ts = candidate.timestamp()

            if candidate_ts <= now:
                continue

            path_string = str(path)

            if (
                current_resolved is None
                or path_string != current_resolved
            ):
                return (
                    candidate_ts,
                    name,
                    path,
                )

    return None, None, None


def set_family_next_change():

    family = state.get(
        "family"
    )

    if not family:

        state["next_change"] = None

        return None

    next_change, _, _ = next_family_change(
        family,
        state.get("current"),
    )

    state["next_change"] = next_change

    return next_change


def choose_random_family():

    families = build_families()

    if not families:

        return None

    names = list(
        families.keys()
    )

    return random.choice(
        names
    )


# ============================================================
# APPLY WALLPAPER
# ============================================================

def apply_wallpaper(
    path,
    reason="manual",
):

    if path is None:

        return False

    try:

        path = (
            Path(path)
            .expanduser()
            .resolve()
        )

    except OSError:

        return False

    if not path.exists():

        log(
            f"wallpaper does not exist: {path}"
        )

        return False

    if not is_image(path):

        log(
            f"not an image: {path}"
        )

        return False

    previous = state.get(
        "current"
    )

    if not set_awww_wallpaper(
        path
    ):

        return False

    if (
        previous
        and previous != str(path)
    ):

        state["previous"] = previous

    state["current"] = str(
        path
    )

    family, variant = (
        split_family(path)
    )

    state["family"] = family

    state["variant"] = variant

    state["last_reason"] = reason

    state["last_changed"] = time.time()

    update_current_link(
        path
    )

    save_state()

    log(
        f"selected: {path.name} "
        f"({reason})"
    )

    return True


# ============================================================
# MODES
# ============================================================

def set_mode(
    mode,
    interval=None,
):

    if mode not in {
        "manual",
        "periodic",
        "family-time",
        "rotate-time",
    }:

        return (
            False,
            "unknown mode",
        )

    if (
        mode in {
            "periodic",
            "rotate-time",
        }
        and (
            interval is None
            or interval < 1
        )
    ):

        return (
            False,
            "interval must be >= 1 minute",
        )

    state["mode"] = mode

    state["interval"] = (
        interval
        if interval is not None
        else None
    )

    if mode == "manual":

        state["next_change"] = None

    elif mode == "family-time":

        current = state.get(
            "current"
        )

        if current:

            family, _ = split_family(
                Path(current)
            )
            state["family"] = family

            selected = choose_time_variant(
                family
            )

            if selected:

                apply_wallpaper(
                    selected,
                    "family-time",
                )

        set_family_next_change()

    else:

        state["next_change"] = (
            time.time()
            + interval * 60
        )

        if mode == "rotate-time":

            selected_family = (
                choose_random_family()
            )

            if selected_family:

                state["family"] = selected_family

                selected = (
                    choose_time_variant(
                        selected_family
                    )
                )

                if selected:

                    apply_wallpaper(
                        selected,
                        "rotate-time",
                    )

    save_state()

    return (
        True,
        "mode changed",
    )


# ============================================================
# AUTOMATIC TICK
# ============================================================

def automatic_tick():

    mode = state.get(
        "mode",
        "manual",
    )

    if mode == "manual":

        return

    now = time.time()

    if mode == "family-time":

        family = state.get(
            "family"
        )

        if not family:

            current = state.get(
                "current"
            )

            if current:

                family, _ = split_family(
                    Path(current)
                )
                state["family"] = family

        if family:

            desired = choose_time_variant(
                family
            )

            if (
                desired
                and str(desired.resolve())
                != str(
                    Path(
                        state.get("current", "")
                    ).resolve()
                )
            ):

                apply_wallpaper(
                    desired,
                    "family-time",
                )

            set_family_next_change()
            save_state()

        return

    next_change = state.get(
        "next_change"
    )

    if (
        next_change is not None
        and now < next_change
    ):

        return

    if mode == "periodic":

        scan_wallpapers()

        if not wallpapers:

            return

        selected = random.choice(
            wallpapers
        )

        if (
            len(wallpapers) > 1
            and state.get("current")
            == str(selected)
        ):

            selected = random.choice(
                [
                    path
                    for path in wallpapers
                    if str(path)
                    != state.get("current")
                ]
            )

        apply_wallpaper(
            selected,
            "periodic",
        )

    elif mode == "rotate-time":

        family = choose_random_family()

        if family:

            state["family"] = family

            selected = (
                choose_time_variant(
                    family
                )
            )

            if selected:

                apply_wallpaper(
                    selected,
                    "rotate-time",
                )

    interval = state.get(
        "interval"
    )

    if interval:

        state["next_change"] = (
            time.time()
            + interval * 60
        )

        save_state()


# ============================================================
# RELOAD
# ============================================================

def restart_controller():

    # Kept as a compatibility helper for callers that may still
    # reference it. Reload is now handled in-process so that a
    # wallpaper reload never creates a second controller process.
    scan_wallpapers(force=True)

    if state.get("mode") == "family-time":

        family = state.get("family")

        if not family:
            current = state.get("current")
            if current:
                family, _ = split_family(Path(current))
                state["family"] = family

        if family:
            selected = choose_time_variant(family)
            current = state.get("current")

            if (
                selected is not None
                and str(selected) != str(current)
            ):
                apply_wallpaper(
                    selected,
                    "family-time",
                )

            set_family_next_change()

    save_state()
    return True


def command_reload():

    count = len(
        scan_wallpapers(force=True)
    )

    restart_controller()

    global restart_requested
    restart_requested = False

    return (
        f"reloaded; found {count} wallpaper"
        + ("s" if count != 1 else "")
        + "\n"
    )


# ============================================================
# STATUS
# ============================================================

def format_duration(seconds):

    seconds = max(
        0,
        int(seconds),
    )

    days, seconds = divmod(
        seconds,
        86400,
    )

    hours, seconds = divmod(
        seconds,
        3600,
    )

    minutes, seconds = divmod(
        seconds,
        60,
    )

    parts = []

    if days:
        parts.append(f"{days}d")

    if hours:
        parts.append(f"{hours}h")

    if minutes:
        parts.append(f"{minutes}m")

    if seconds or not parts:
        parts.append(f"{seconds}s")

    return " ".join(parts)


def format_schedule_time(hour):

    return f"{hour:02d}:00"


def command_status():

    scan_wallpapers()

    current = state.get(
        "current"
    )

    previous = state.get(
        "previous"
    )

    mode = state.get(
        "mode",
        "manual",
    )

    interval = state.get(
        "interval"
    )

    next_change = state.get(
        "next_change"
    )

    lines = [
        "Controller: running",
        f"PID:        {os.getpid()}",
        "",
        f"Mode:       {mode}",
    ]

    # --------------------------------------------------------
    # Mode-specific state
    # --------------------------------------------------------

    if mode == "family-time":

        family = state.get(
            "family"
        )

        lines.append(
            f"Family:     {family or '-'}"
        )

    elif mode in {
        "periodic",
        "rotate-time",
    }:

        lines.append(
            f"Interval:   {interval} min"
            if interval
            else "Interval:   -"
        )

        if mode == "rotate-time":

            lines.append(
                f"Family:     {state.get('family') or '-'}"
            )

    # --------------------------------------------------------
    # Wallpaper state
    # --------------------------------------------------------

    lines.extend(
        [
            "",
            f"Wallpapers: {len(wallpapers)}",
            f"Current:    {Path(current).name if current else '-'}",
            f"Previous:   {Path(previous).name if previous else '-'}",
        ]
    )

    # --------------------------------------------------------
    # Family-time schedule
    # --------------------------------------------------------

    if mode == "family-time":

        family = state.get(
            "family"
        )

        if family:

            schedule = family_time_schedule(
                family
            )

            lines.extend(
                [
                    "",
                    "Schedule:",
                ]
            )

            for name, hour, path in schedule:

                lines.append(
                    f"  {format_schedule_time(hour)}  {path.name}"
                )

    # --------------------------------------------------------
    # Actual wallpaper reported by awww
    # --------------------------------------------------------

    # awww is queried only for an explicit status request; it
    # does not run in the background.
    awww_data = query_awww()

    awww_paths = []

    if (
        isinstance(
            awww_data,
            dict,
        )
        and "error" not in awww_data
    ):

        awww_paths = extract_awww_paths(
            awww_data
        )

    lines.extend(
        [
            "",
        ]
    )

    if len(awww_paths) == 1:

        lines.append(
            f"awww:       {Path(awww_paths[0]).name}"
        )

    elif len(awww_paths) > 1:

        lines.append(
            f"awww:       {len(awww_paths)} wallpapers"
        )

    elif (
        isinstance(
            awww_data,
            dict,
        )
        and "error" in awww_data
    ):

        lines.append(
            "awww:       unavailable"
        )

    else:

        lines.append(
            "awww:       -"
        )

    # --------------------------------------------------------
    # Current symlink
    # --------------------------------------------------------

    lines.extend(
        [
            "",
            "Current link:",
            f"  {CURRENT_LINK}",
        ]
    )

    if CURRENT_LINK.is_symlink():

        try:

            lines.append(
                f"  -> {CURRENT_LINK.resolve()}"
            )

        except OSError:

            lines.append(
                "  -> <broken symlink>"
            )

    elif CURRENT_LINK.exists():

        lines.append(
            "  -> <not a symlink>"
        )

    else:

        lines.append(
            "  -> <not present>"
        )

    # --------------------------------------------------------
    # Last change
    # --------------------------------------------------------

    last_changed = state.get(
        "last_changed"
    )

    last_reason = state.get(
        "last_reason"
    )

    if last_changed:

        local_changed = datetime.fromtimestamp(
            last_changed
        )

        reason = (
            last_reason
            or "unknown"
        )

        lines.extend(
            [
                "",
                "Last change:",
                f"  {local_changed:%Y-%m-%d %H:%M:%S}  ({reason})",
            ]
        )

    else:

        lines.extend(
            [
                "",
                "Last change: -",
            ]
        )

    # --------------------------------------------------------
    # Next actual wallpaper change
    # --------------------------------------------------------

    if mode == "family-time":

        next_ts, next_name, next_path = next_family_change(
            state.get("family"),
            current,
        )

        if next_ts is not None:

            local_next = datetime.fromtimestamp(
                next_ts
            )

            lines.extend(
                [
                    "",
                    "Next change:",
                    f"  {local_next:%H:%M}  {next_path.name}",
                    f"  in {format_duration(next_ts - time.time())}",
                ]
            )

        else:

            lines.extend(
                [
                    "",
                    "Next change: none",
                ]
            )

    elif mode in {
        "periodic",
        "rotate-time",
    } and next_change:

        lines.extend(
            [
                "",
                "Next change:",
                f"  at {datetime.fromtimestamp(next_change):%H:%M}",
                f"  in {format_duration(next_change - time.time())}",
            ]
        )

    else:

        lines.extend(
            [
                "",
                "Next change: disabled",
            ]
        )

    # --------------------------------------------------------
    # Detect external awww changes
    # --------------------------------------------------------

    if current and len(awww_paths) == 1:

        try:

            wpp_path = Path(current).resolve()
            awww_path = Path(awww_paths[0]).resolve()

            if wpp_path != awww_path:

                lines.extend(
                    [
                        "",
                        "Notice: awww is displaying a different "
                        "wallpaper than the last one selected by wpp.",
                    ]
                )

        except OSError:

            pass

    return (
        "\n".join(lines)
        + "\n"
    )


# ============================================================
# CURRENT WALLPAPER
# ============================================================

def command_current():

    data = query_awww()

    if "error" in data:

        return (
            "error: "
            + data["error"]
            + "\n"
        )

    paths = extract_awww_paths(
        data
    )

    if not paths:

        current = state.get(
            "current"
        )

        if current:

            return (
                current
                + "\n"
            )

        return (
            "error: awww returned no "
            "wallpaper path\n"
        )

    # IMPORTANT:
    #
    # Do NOT update CURRENT_LINK here.
    #
    # CURRENT_LINK means:
    #   "last wallpaper selected through wpp"
    #
    # It should not change simply because the user queried
    # awww's current state.

    if len(paths) == 1:

        return (
            paths[0]
            + "\n"
        )

    return (
        "awww is displaying:\n"
        + "\n".join(paths)
        + "\n"
    )


# ============================================================
# RELOAD / DIRECTORY
# ============================================================

def command_reload_directory_only():

    count = len(
        scan_wallpapers()
    )

    return (
        f"found {count} wallpaper"
        + ("s" if count != 1 else "")
        + "\n"
    )


def command_reload_alias():

    return command_reload()


# ============================================================
# SET
# ============================================================

def command_set(
    argument,
):

    path = (
        Path(argument)
        .expanduser()
    )

    if not path.is_absolute():

        path = (
            WALLPAPER_DIR
            / path
        )

    try:

        path = path.resolve()

    except OSError:

        return (
            "error: invalid wallpaper path\n"
        )

    if not path.exists():

        return (
            "error: wallpaper not found: "
            + str(path)
            + "\n"
        )

    if not is_image(path):

        return (
            "error: unsupported image: "
            + str(path)
            + "\n"
        )

    if apply_wallpaper(
        path,
        "manual",
    ):

        return (
            str(path)
            + "\n"
        )

    return (
        "error: failed to set wallpaper\n"
    )


# ============================================================
# NEXT
# ============================================================

def command_next():

    selected = select_next()

    if selected is None:

        return (
            "error: no wallpapers found\n"
        )

    if apply_wallpaper(
        selected,
        "next",
    ):

        return (
            str(selected)
            + "\n"
        )

    return (
        "error: failed to set wallpaper\n"
    )


# ============================================================
# PREVIOUS
# ============================================================

def command_previous():

    selected = select_previous()

    if selected is None:

        return (
            "error: no wallpapers found\n"
        )

    if apply_wallpaper(
        selected,
        "previous",
    ):

        return (
            str(selected)
            + "\n"
        )

    return (
        "error: failed to set wallpaper\n"
    )


# ============================================================
# SOCKET COMMAND HANDLING
# ============================================================

def handle_command(
    command,
):

    parts = command.strip().split(
        maxsplit=2
    )

    if not parts:

        return (
            "error: empty command\n"
        )

    name = parts[0]

    if name == "status":

        return command_status()

    if name == "current":

        return command_current()

    if name == "reload":

        return command_reload()

    if name == "next":

        return command_next()

    if name == "previous":

        return command_previous()

    if name == "set":

        if len(parts) < 2:

            return (
                "error: set requires "
                "a wallpaper path\n"
            )

        return command_set(
            parts[1]
        )

    if name == "mode":

        if len(parts) < 2:

            return (
                "error: mode requires "
                "a mode\n"
            )

        mode = parts[1]

        if mode == "manual":

            ok, message = set_mode(
                "manual"
            )

        elif mode == "periodic":

            if len(parts) < 3:

                return (
                    "error: periodic requires "
                    "minutes\n"
                )

            try:

                minutes = int(
                    parts[2]
                )

            except ValueError:

                return (
                    "error: minutes must be "
                    "an integer\n"
                )

            ok, message = set_mode(
                "periodic",
                minutes,
            )

        elif mode == "family-time":

            ok, message = set_mode(
                "family-time"
            )

        elif mode == "rotate-time":

            if len(parts) < 3:

                return (
                    "error: rotate-time requires "
                    "minutes\n"
                )

            try:

                minutes = int(
                    parts[2]
                )

            except ValueError:

                return (
                    "error: minutes must be "
                    "an integer\n"
                )

            ok, message = set_mode(
                "rotate-time",
                minutes,
            )

        else:

            return (
                "error: unknown mode: "
                + mode
                + "\n"
            )

        if ok:

            return (
                f"mode: {state['mode']}\n"
            )

        return (
            "error: "
            + message
            + "\n"
        )

    if name == "stop":

        global running

        running = False

        return (
            "stopping\n"
        )

    if name == "ping":

        return "ok\n"

    return (
        "error: unknown command: "
        + name
        + "\n"
    )


# ============================================================
# SOCKET
# ============================================================

def accept_connection(
    sock,
    mask,
):

    try:

        connection, _ = (
            sock.accept()
        )

        connection.setblocking(
            False
        )

        selector.register(
            connection,
            selectors.EVENT_READ,
            read_connection,
        )

    except OSError:

        pass


def read_connection(
    connection,
    mask,
):

    try:

        data = connection.recv(
            65536
        )

    except OSError:

        data = b""

    if not data:

        try:

            selector.unregister(
                connection
            )

        except Exception:

            pass

        connection.close()

        return

    command = (
        data.decode(
            "utf-8",
            errors="replace",
        )
    )

    response = handle_command(
        command
    )

    try:

        connection.sendall(
            response.encode(
                "utf-8"
            )
        )

    except OSError:

        pass

    try:

        selector.unregister(
            connection
        )

    except Exception:

        pass

    connection.close()


# ============================================================
# SIGNALS
# ============================================================

def handle_signal(
    signum,
    frame,
):

    global running

    running = False


# ============================================================
# INITIALIZATION
# ============================================================

def initialize_wallpaper():

    scan_wallpapers()

    if not wallpapers:

        log(
            "no wallpapers found"
        )

        return

    selected = choose_initial_wallpaper()

    if selected is None:

        return

    # Restore the controller's last selected wallpaper.
    #
    # In family-time, however, the restored family must first
    # be reconciled with the current time slot.
    if (
        state.get("current")
        and str(selected)
        == state.get("current")
    ):

        family, _ = split_family(
            selected
        )

        state["family"] = family

        if state.get("mode") == "family-time":

            time_selected = choose_time_variant(
                family
            )

            if (
                time_selected
                and str(time_selected.resolve())
                != str(selected.resolve())
            ):

                apply_wallpaper(
                    time_selected,
                    "family-time",
                )
            else:
                update_current_link(
                    selected
                )

            set_family_next_change()
            save_state()

        else:

            update_current_link(
                selected
            )

        return

    apply_wallpaper(
        selected,
        "startup",
    )

    if state.get("mode") == "family-time":

        family, _ = split_family(
            Path(
                state.get("current")
            )
        )

        state["family"] = family

        time_selected = choose_time_variant(
            family
        )

        if (
            time_selected
            and str(time_selected.resolve())
            != str(
                Path(
                    state.get("current")
                ).resolve()
            )
        ):

            apply_wallpaper(
                time_selected,
                "family-time",
            )

        set_family_next_change()
        save_state()


# ============================================================
# MAIN LOOP
# ============================================================

def cleanup():

    try:

        selector.close()

    except Exception:

        pass

    if server is not None:

        try:

            server.close()

        except Exception:

            pass

    try:

        if SOCKET_PATH.exists():

            SOCKET_PATH.unlink()

    except OSError:

        pass


def main():

    global server
    global restart_requested
    global running

    STATE_DIR.mkdir(
        parents=True,
        exist_ok=True,
    )

    load_state()

    # Remove stale socket.
    if SOCKET_PATH.exists():

        try:

            SOCKET_PATH.unlink()

        except OSError:

            pass

    server = socket.socket(
        socket.AF_UNIX,
        socket.SOCK_STREAM,
    )

    server.bind(
        str(SOCKET_PATH)
    )

    server.listen(8)

    server.setblocking(
        False
    )

    # User-only permissions.
    try:

        os.chmod(
            SOCKET_PATH,
            0o600,
        )

    except OSError:

        pass

    selector.register(
        server,
        selectors.EVENT_READ,
        accept_connection,
    )

    signal.signal(
        signal.SIGTERM,
        handle_signal,
    )

    signal.signal(
        signal.SIGINT,
        handle_signal,
    )

    initialize_wallpaper()

    log(
        "controller started"
    )

    try:

        while running:

            # ------------------------------------------------
            # Calculate how long we can sleep.
            #
            # Manual mode has no timer, so the selector sleeps
            # until a command arrives.
            # ------------------------------------------------

            timeout = None

            mode = state.get(
                "mode",
                "manual",
            )

            if mode == "family-time":

                next_change = state.get(
                    "next_change"
                )

                if next_change is not None:

                    timeout = max(
                        0,
                        next_change - time.time(),
                    )

                else:

                    timeout = None

            elif mode in {
                "periodic",
                "rotate-time",
            }:

                next_change = (
                    state.get(
                        "next_change"
                    )
                )

                if next_change is not None:

                    timeout = max(
                        0,
                        next_change
                        - time.time(),
                    )

                else:

                    interval = (
                        state.get(
                            "interval"
                        )
                    )

                    timeout = (
                        interval * 60
                        if interval
                        else 60
                    )

            events = selector.select(
                timeout
            )

            for key, mask in events:

                callback = key.data

                callback(
                    key.fileobj,
                    mask,
                )

            if running:

                automatic_tick()

    finally:

        cleanup()


if __name__ == "__main__":

    main()
